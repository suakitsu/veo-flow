# =============================================================================
# Veo Flow 环境变量配置示例
# 复制为 .env 并填入实际值：cp .env.example .env
# =============================================================================

# ── GCP 凭证 ──────────────────────────────────────────────────────────────────
# Google Cloud 项目 ID（也可在 config.json 中配置）
GCP_PROJECT_ID=your-gcp-project-id

# 服务账号密钥文件路径（也可在 config.json 中配置）
# Vertex AI 模式：指向 vertex.json 服务号密钥文件
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex.json

# ── 网络代理 ──────────────────────────────────────────────────────────────────
# HTTP/HTTPS 代理（中国大陆访问 Google API 需要）
# 留空则不启用代理（直连）
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ── Flask 应用 ────────────────────────────────────────────────────────────────
# 调试模式（生产环境必须为 false；true 时错误响应会包含详细异常信息）
FLASK_DEBUG=false

# 服务端口
PORT=5000

# CORS 白名单（逗号分隔，生产环境填你的域名）
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── API 鉴权 ──────────────────────────────────────────────────────────────────
# API Key 鉴权密钥（留空则禁用鉴权；生产环境务必设置）
# 客户端通过 Authorization: Bearer <key> 或 X-API-Key: <key> 传递
# 注意：query parameter 方式已移除（避免 URL 日志泄露）
API_KEY=

# 可信代理 IP（逗号分隔，Nginx/CDN 部署时填代理服务器 IP）
# 留空则不信任任何 X-Forwarded-For（最安全，仅用直连 IP）
# 生产环境示例：TRUSTED_PROXIES=127.0.0.1,10.0.0.1
TRUSTED_PROXIES=

# ── 日志 ─────────────────────────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── 文件清理 ──────────────────────────────────────────────────────────────────
# 输出文件保留时长（小时），默认 7 天
OUTPUT_TTL_HOURS=168

# 上传文件保留时长（小时），默认 1 天
UPLOAD_TTL_HOURS=24

# 清理检查间隔（小时），默认 1 小时
CLEANUP_INTERVAL_HOURS=1

# ── API 重试 ──────────────────────────────────────────────────────────────────
# 最大重试次数（默认 3）
API_MAX_RETRIES=3
# 初始退避秒数（默认 2.0，指数递增）
API_INITIAL_BACKOFF=2.0
# 最大退避秒数（默认 60.0）
API_MAX_BACKOFF=60.0

# ── 并发限制 ──────────────────────────────────────────────────────────────────
# 每用户最大并行任务数（默认 1）
MAX_TASKS_PER_USER=1
# 全局最大并行任务数（0 = 不限制）
MAX_GLOBAL_TASKS=0

# ── 任务 TTL 清理 ────────────────────────────────────────────────────────────
# 已完成任务保留时长（秒），默认 7 天
TASK_TTL_SECONDS=604800
# _tasks 字典最大条目数（超出时淘汰最旧的），默认 1000
MAX_TASKS_IN_MEMORY=1000
# 清理检查间隔（秒），默认 1 小时
TASK_CLEANUP_INTERVAL=3600

# ── 文件上传安全 ──────────────────────────────────────────────────────────────
# 单文件最大上传大小（字节），默认 50 MB
# 也可通过此变量调整 MAX_UPLOAD_SIZE
