# =============================================================================
# Veo Flow 环境变量配置示例
# 复制为 .env 并填入实际值：cp .env.example .env
# =============================================================================

# ── GCP 凭证 ──────────────────────────────────────────────────────────────────
# Google Cloud 项目 ID（也可在 config.json 中配置）
GCP_PROJECT_ID=your-gcp-project-id

# 服务账号密钥文件路径（也可在 config.json 中配置）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex.json

# ── 网络代理 ──────────────────────────────────────────────────────────────────
# HTTP/HTTPS 代理（中国大陆访问 Google API 需要）
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ── Flask 应用 ────────────────────────────────────────────────────────────────
# 调试模式（生产环境必须为 false）
FLASK_DEBUG=false

# 服务端口
PORT=5000

# CORS 白名单（逗号分隔，生产环境填你的域名）
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# API 鉴权密钥（留空则禁用鉴权；生产环境务必设置）
# 客户端通过 Authorization: Bearer <key> 或 X-API-Key: <key> 传递
API_KEY=

# 可信代理 IP（逗号分隔，Nginx/CDN 部署时填代理服务器 IP）
# 留空则信任所有 X-Forwarded-For（仅开发环境推荐）
# 生产环境示例：TRUSTED_PROXIES=127.0.0.1,10.0.0.1
TRUSTED_PROXIES=

# ── 日志 ─────────────────────────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── 文件清理 ──────────────────────────────────────────────────────────────────
# 输出文件保留时长（小时），默认 7 天
OUTPUT_TTL_HOURS=168

# 上传文件保留时长（小时），默认 1 天
UPLOAD_TTL_HOURS=24

# 清理检查间隔（小时），默认 1 小时
CLEANUP_INTERVAL_HOURS=1
